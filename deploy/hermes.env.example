# deploy/hermes.env (chmod 600) - secrets for the Hermes gateway container only.
# Service token for the construction tools (from: docker compose exec web chops issue-agent-token)
CHOPS_MCP_TOKEN=
# Internal URL of the construction tool server (compose service name)
CHOPS_MCP_URL=http://mcp:8641/mcp
# Model: the default is ChatGPT sign-in (provider openai-codex). No key goes here for that;
# run: docker compose -p construction-hermes exec hermes hermes auth add openai-codex --type oauth
# then: ... exec hermes hermes model  (choose "ChatGPT or Codex Subscription").
# Login is stored by Hermes in HERMES_HOME/auth.json (hermes_data volume).
# Alternatively, ONE API key for another provider:
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# Telegram gateway (numeric user IDs only; usernames are not identity)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=123456789
