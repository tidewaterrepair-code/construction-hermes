# deploy/.env  (chmod 600) - secrets for the construction-hermes compose project.
# Generate passwords with: openssl rand -base64 32
POSTGRES_SUPERUSER_PASSWORD=
CHOPS_OWNER_DB_PASSWORD=
CHOPS_APP_DB_PASSWORD=
# Session/CSRF signing secret
CHOPS_SECRET_KEY=
CHOPS_ENV=prod
# Public URL you use on your phone (private network / VPN address), used in approval links
CHOPS_BASE_URL=https://ops.example.internal
# true when the dashboard is served over HTTPS (required for any non-localhost access)
CHOPS_COOKIE_SECURE=true

# Backups: host paths (key must also be copied somewhere OFF this server)
CHOPS_BACKUP_HOST_DIR=/var/backups/construction-hermes
CHOPS_BACKUP_KEY_HOST_FILE=/etc/construction-hermes/backup.key
CHOPS_BACKUP_KEEP=14

# Optional: owner alerts via a Telegram bot (separate from the Hermes gateway bot is fine)
# CHOPS_TELEGRAM_BOT_TOKEN=
# CHOPS_TELEGRAM_OWNER_CHAT_ID=
# CHOPS_OUTBOUND_HOSTS=api.telegram.org

# Optional: customer email via SMTP (disconnected unless all are set)
# CHOPS_SMTP_HOST=
# CHOPS_SMTP_PORT=587
# CHOPS_SMTP_USER=
# CHOPS_SMTP_PASSWORD=
# CHOPS_SMTP_FROM=
