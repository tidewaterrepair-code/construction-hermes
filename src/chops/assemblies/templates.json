[
  {
    "code": "deck-basic",
    "name": "Deck - rectangular, attached (quantity template)",
    "trade": "decks",
    "description": "Example quantity template for a simple attached rectangular deck. Not an engineered design: joist size/spacing, beam, footing size/depth, ledger attachment and guards must be verified against the adopted code and project-specific requirements.",
    "parameters": [
      {"name": "length_ft", "unit": "ft", "label": "Length along house", "required": true},
      {"name": "width_ft", "unit": "ft", "label": "Projection from house", "required": true},
      {"name": "joist_spacing_in", "unit": "in", "label": "Joist spacing (verify)", "required": true, "default": "16"},
      {"name": "board_face_in", "unit": "in", "label": "Decking board face width", "required": true, "default": "5.5"},
      {"name": "footing_count", "unit": "ea", "label": "Footings (from layout)", "required": true},
      {"name": "labor_hours_per_sqft", "unit": "hr/sqft", "label": "Crew productivity (owner data)", "required": true}
    ],
    "components": [
      {"kind": "material", "description": "Joists (each spans projection)", "rate_code": "LUMBER-JOIST-LF", "unit": "lf", "qty": "(ceil(length_ft*12/joist_spacing_in)+1)*width_ft", "waste": "0.10", "cost_code": "06-framing"},
      {"kind": "material", "description": "Rim/band and ledger boards", "rate_code": "LUMBER-JOIST-LF", "unit": "lf", "qty": "length_ft*2 + width_ft*2", "waste": "0.10", "cost_code": "06-framing"},
      {"kind": "material", "description": "Decking boards", "rate_code": "DECKING-LF", "unit": "lf", "qty": "length_ft*width_ft*12/board_face_in", "waste": "0.10", "cost_code": "06-decking"},
      {"kind": "material", "description": "Footing concrete (allow per footing)", "rate_code": "CONCRETE-BAG", "unit": "bag", "qty": "footing_count*4", "waste": "0", "cost_code": "03-concrete"},
      {"kind": "material", "description": "Hangers, fasteners, flashing (allow)", "rate_code": "HARDWARE-DECK-SQFT", "unit": "sqft", "qty": "length_ft*width_ft", "waste": "0", "cost_code": "06-hardware"},
      {"kind": "labor", "description": "Deck framing and decking labor", "rate_code": "LABOR-CARPENTER-HR", "unit": "hr", "qty": "length_ft*width_ft*labor_hours_per_sqft", "waste": "0", "cost_code": "06-labor"},
      {"kind": "disposal", "description": "Debris disposal", "rate_code": "DISPOSAL-LOAD", "unit": "load", "qty": "1", "waste": "0", "cost_code": "01-general"}
    ],
    "notes": "Stairs, railings/guards, demolition and permits are separate line items."
  },
